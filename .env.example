# --- Supabase ---------------------------------------------------------------
# Project Settings → API, no painel do Supabase.
# Sem estes valores a aplicação arranca na mesma e mostra as instruções.
NEXT_PUBLIC_SUPABASE_URL=https://exemplo-substituir.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=chave-anonima-de-exemplo-substituir

# --- Endereço público -------------------------------------------------------
# Usado nos links enviados por email (convites e recuperação de palavra-passe).
# Em desenvolvimento: http://localhost:3000
# Na Vercel pode ficar em branco — é deduzido dos cabeçalhos do pedido.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Notificações no telemóvel ----------------------------------------------
# Gerar o par com:  npx web-push generate-vapid-keys
# A pública vai no browser (é mesmo pública: identifica quem tem direito a
# mandar avisos para aquele aparelho). A privada é secreta e só o servidor a vê.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Endereço de contacto que acompanha cada envio, exigido pela norma.
VAPID_CONTACTO=mailto:geral@quintadafigueira.pt

# Chave de serviço do Supabase. **Ignora toda a RLS.**
# Serve só para o envio de notificações, em lib/notificacoes/enviar.ts, que é
# o único ficheiro autorizado a lê-la. Sem ela a aplicação funciona na mesma;
# só não manda avisos.
SUPABASE_SERVICE_ROLE_KEY=
